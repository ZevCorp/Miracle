# Copia este archivo como `.env.local` y rellena los valores.
# `.env.local` está gitignored: nunca subas secretos al repo.

# Supabase — claves PÚBLICAS (seguras para el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Dominio del sitio (canonical/OG/metadataBase). Producción: https://itsmiracleai.com.co
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Backend clínico (motor Miracle) — plantillas, encounters y generación de notas.
# El frontend le habla SOLO a este API (con el token Supabase del usuario);
# nunca directo a Supabase para las tablas clínicas ni con service-role key.
# Local: http://localhost:3000 · Producción: URL del deployment del backend.
# OJO: el backend debe incluir el origen del frontend en su ALLOWED_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# API key de plataforma del backend Miracle (SECRETA, solo servidor: nunca con
# prefijo NEXT_PUBLIC_). La usa /api/stt/session para pedir las credenciales
# temporales de transcripción en vivo. Formato: miracle_...
MIRACLE_API_KEY=

# Nota: CREAR cuentas (super-admin / admin → "Agregar médico") NO necesita la
# service-role key — se hace con la función SECURITY DEFINER create_org_member.
# No hay que configurar nada extra en el servidor ni en Vercel.

# IA de VISIÓN (lectura de fotos) — SECRETA, solo servidor (nunca NEXT_PUBLIC_).
# Es la MISMA key para las dos funciones que leen imágenes:
#   · /api/parse-schedule          → importar la agenda del día desde una foto.
#   · /api/clinical/note-from-photo → informe de patología desde la foto de la hoja
#                                     manuscrita (solo cuentas patólogo).
# Sin ella NADA se rompe: ambas pantallas degradan a "rellenar a mano". Por eso, si
# falta en Vercel, la feature de patología queda desplegada pero inútil.
# REQUERIDA en Vercel (proyecto miracle-web, scope Production) para que la foto funcione.
# Ver docs/pendiente-patologia-api-key.md
ANTHROPIC_API_KEY=
# Opcional; por defecto claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Nota: la generación de notas clínicas desde AUDIO no usa esta key: la hace el
# backend Miracle (NEXT_PUBLIC_API_BASE_URL).

# Billing B2C (Stripe) — todas SECRETAS, solo servidor (nunca NEXT_PUBLIC_).
# El checkout y el portal son páginas hosted de Stripe: no hay JS de Stripe en
# el navegador y ninguna tarjeta toca Miracle. Sin estas variables la app
# degrada con gracia: el trial y las cortesías siguen gobernando el acceso y la
# página /suscripcion explica que los pagos aún no están configurados.
# Claves de PRUEBA primero (sk_test_...); a producción solo cambiando claves.
STRIPE_SECRET_KEY=
# Price mensual del plan B2C (Stripe → Products → Price en COP). price_...
STRIPE_PRICE_ID_PRO=
# Firma del webhook /api/billing/webhook. En local la da `stripe listen`
# (whsec_...); en producción, el endpoint creado en el dashboard de Stripe.
STRIPE_WEBHOOK_SECRET=

# Supabase — secret key (sb_secret_...), SOLO para el módulo de billing
# (lib/billing/admin.ts): el webhook de Stripe llega sin sesión de usuario y
# necesita escribir billing_accounts/billing_events, que no tienen grants para
# authenticated. Es la ÚNICA credencial privilegiada del proyecto y NO toca
# datos clínicos (decisión D15 en docs/decisiones.md).
SUPABASE_SECRET_KEY=

# Observabilidad (opcional) — reporte de errores con Sentry.
# Los archivos ya están cableados (instrumentation*.ts, next.config.ts): SIN
# esta variable todo es no-op y el build es idéntico al de hoy. Para activarlo,
# crea el proyecto en Sentry y pega su DSN aquí (y en Vercel, entorno Production).
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oyyyy.ingest.sentry.io/zzzz

# Cuentas de PRUEBA — SOLO para desarrollo local.
# Las usa scripts/dev-session.mjs para abrir sesión y revisar las pantallas de
# cada rol sin escribir la contraseña a mano cada vez. El script tiene una lista
# blanca cerrada: solo cuentas @miracle.app, nunca la de un médico real ni la de
# ninguna organización cliente. Ver `node scripts/dev-session.mjs help`.
#
# NO pegues aquí ningún valor real: el repositorio es público. Van en .env.local.
# Si no recuerdas alguna: Supabase → Authentication → Users → Reset password.
#
# NO hace falta editar .env.local a mano. La primera vez de cada cuenta:
#   node scripts/dev-session.mjs <alias> --guardar
# te pide la contraseña por teclado (no se ve al teclearla, no queda en el
# historial del shell), comprueba que sirve y solo entonces la guarda.
#
# demo@miracle.app — demo comercial (la contraseña vive en
# supabase/seed/demo-account.sql, que está fuera del repo):
# DEMO_ACCOUNT_PASSWORD=
# medico@miracle.app — consulta nueva y grabación en vivo:
# TEST_MEDICO_PASSWORD=
# patologo@miracle.app — laboratorio y nota desde foto:
# TEST_PATOLOGO_PASSWORD=
# supervisor@miracle.app — auditoría y reportes de toda la organización
# (cuenta creada por supabase/seed/test-supervisor.sql, nace SIN contraseña
# utilizable: ponle una en Supabase → Authentication → Users):
# TEST_SUPERVISOR_PASSWORD=
# admin@miracle.app — usuarios, auditoría y reportes del hospital:
# TEST_ADMIN_PASSWORD=
# superadmin@miracle.app — consola de plataforma (/superadmin):
# TEST_SUPERADMIN_PASSWORD=
