#!/usr/bin/env bash
# EL PORTERO DE WINDOWS. Lo único de todo el flujo que no se puede olvidar.
#
# Por qué existe (2026-08-21): el repo tenía 6 archivos de reglas y 7 skills describiendo cómo se
# trabaja, y en .git/hooks solo había post-checkout y post-commit. O sea: todo el proceso eran
# PETICIONES, y ninguna garantía. El usuario lo dijo con sus palabras — «demasiada burocracia pero
# no siento que me esté verificando lo que necesito» — y tenía razón: era papeleo sin portero.
#
# La regla es una: lo que TIENE que pasar va aquí; los .md explican el porqué, que es lo que un
# hook no sabe hacer.
#
# Lo llama el despachador de la raíz (.githooks/pre-push) cuando la rama toca apps/windows/. Desde
# el 2026-09-30 aquí solo se declara lo propio de Windows; las cuatro comprobaciones son del motor
# común (tools/monorepo/portero.sh). Lo que ganó con el cambio: juzga LO QUE SE EMPUJA. Antes
# compilaba el árbol de trabajo y miraba la rama en la que estabas parado, así que un cambio sin
# commitear podía darle verde a un commit que no lo traía. Si el árbol está limpio se juzga aquí
# mismo, como siempre (~60-120 s); si tiene cambios sin commitear que tocan el veredicto, el commit
# se saca a un árbol temporal y se compila allí, que tarda más. Para el camino rápido: commitea, o
# git stash -u.
#
# Un portero que cansa es un portero que alguien acaba saltándose con --no-verify: si esto tarda
# más de lo que aguanta la paciencia, se recorta el hook, no la paciencia.
#
# Se prueba sin empujar:
#     printf 'refs/heads/<rama> %s refs/heads/<rama> 0\n' "$(git rev-parse HEAD)" | bash apps/windows/.githooks/pre-push

NOMBRE="Windows"

# El código cuya rama tiene que traer su promesa, y lo que cuenta como promesa. Es lo mismo que
# exigía este portero antes del motor: el cliente, el núcleo y el mapeador.
CODIGO=('windows-client/**/*.cs' 'nucleo/**/*.cs' 'mapeador/**/*.cs')
PROMESAS=('**/Contrato.cs' 'tests/**')
DONDE_PROMESAS="en tests/ContratoDelGrafo/Contrato.cs (o en voz/Contrato/Contrato.cs)"

# Lo que cambia el veredicto: todo menos la documentación y las reglas para agentes.
JUICIO=('.' ':(exclude)docs' ':(exclude)*.md' ':(exclude).claude')

# Se juzga el binario que se distribuye: Release, no Debug (patrón nº13).
compilar() { dotnet build windows-client/WindowsClient.csproj -c Release -v quiet --nologo; }

# Dos contratos hermanos: el del grafo y el de la voz. No son «tests» genéricos: son las promesas
# que el sistema dice cumplir.
#
# Un contrato que no está es ROJO, no «se salta» (2026-09-28). Hasta el monorepo, un script ausente
# se saltaba con un aviso gris; al mover Windows a apps/windows/, un portero que buscara en la raíz
# habría saltado los dos contratos y dado verde sin juzgar nada. Un guardia que se cree puesto es
# peor que ninguno (CLAUDE.md, aprendizaje nº18).
VEREDICTO_OK="INTACTO|ÍNTEGRA|ÍNTEGRO"
juzgar() {
  local rotos=0 par nombre script salida
  for par in "contrato del grafo:scripts/contrato-del-grafo.ps1" "contrato de la voz:scripts/contrato-de-la-voz.ps1"; do
    nombre="${par%%:*}"; script="${par#*:}"
    if [ ! -f "$script" ]; then
      echo "✘ $nombre: no está $script — sin juez no hay veredicto"
      rotos=$((rotos + 1))
      continue
    fi
    salida="$(powershell -NoProfile -ExecutionPolicy Bypass -File "$script" 2>&1)"
    if printf '%s' "$salida" | grep -qE "$VEREDICTO_OK"; then
      echo "$nombre: $(printf '%s\n' "$salida" | grep -E "$VEREDICTO_OK" | tail -1 | sed 's/^ *//')"
    else
      echo "✘ $nombre ROTO"
      printf '%s\n' "$salida" | grep -E "✘|ROTO|incumplid|NO SE PUDO" | head -5
      rotos=$((rotos + 1))
    fi
  done
  return "$rotos"
}

. "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)/tools/monorepo/portero.sh"
