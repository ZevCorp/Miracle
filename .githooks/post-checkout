#!/usr/bin/env bash
# UN AGENTE, UN ÁRBOL: si una sesión de agente cambia de rama en el árbol que usa otra, se le dice
# cómo deshacerlo. Git no deja frenar un cambio de rama antes de hacerlo; por eso la regla es nacer
# con árbol propio (tools/monorepo/arbol.sh nuevo) y no con `git switch -c`.
#
# $3 = 1 en un cambio de rama; 0 al sacar archivos sueltos, que no interesa.
[ "${3:-0}" = "1" ] || exit 0

# EL MAPA AL DÍA: otra rama —o un árbol recién creado— es otro código; el mapa de graphify se rehace
# en segundo plano y no retrasa nada. El porqué está en tools/graphify/refrescar.sh.
refrescar="$(git rev-parse --show-toplevel)/tools/graphify/refrescar.sh"
[ -f "$refrescar" ] && bash "$refrescar"

guardia="$(git rev-parse --show-toplevel)/tools/monorepo/arbol.sh"
[ -f "$guardia" ] || exit 0
exec bash "$guardia" guardia --cambio
