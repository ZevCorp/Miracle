#!/usr/bin/env bash
# EL MAPA AL DÍA: tras cada commit, el mapa de graphify de cada proyecto se rehace en segundo plano.
# Sin graphify instalado no hace nada. El porqué está en tools/graphify/refrescar.sh.
refrescar="$(git rev-parse --show-toplevel)/tools/graphify/refrescar.sh"
[ -f "$refrescar" ] && bash "$refrescar"
exit 0
